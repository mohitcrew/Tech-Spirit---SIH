generator client {
  provider = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  name                String
  role                String              @default("TRAINEE")
  status              String              @default("PENDING")
  onboardingCompleted Boolean             @default(false)
  onboardingStatus    String              @default("PENDING")
  firstLoginRequired  Boolean             @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  profile             Profile?
  createdCourses      Course[]            @relation("CourseCreator")
  enrollments         Enrollment[]
  attempts            AssessmentAttempt[]
  certificates        Certificate[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  emailLogs           EmailLog[]
  @@index([role, status])
}

model Profile {
  id                String  @id @default(uuid())
  userId            String  @unique
  phone             String?
  employeeId        String? @unique
  department        String?
  designation       String?
  qualification     String?
  experience        Int?
  skills            String  @default("")
  interests         String  @default("")
  sector            String? @default("IT")
  domain            String?
  targetRole        String?
  learningGoal      String?
  preferredLearning String?
  bio               String?
  photoUrl          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                 String              @id @default(uuid())
  title              String
  description        String
  category           String
  sector             String            @default("")
  domain             String            @default("")
  skills             String            @default("")
  competencies       String            @default("")
  department         String
  level              String
  durationHours      Int
  trainingMode       String            @default("")
  eligibility        String            @default("")
  courseDates        String            @default("")
  learningObjectives String
  thumbnailUrl       String?
  status             String              @default("DRAFT")
  trainerId          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  trainer            User                @relation("CourseCreator", fields: [trainerId], references: [id])
  modules            CourseModule[]
  resources          LearningResource[]
  enrollments        Enrollment[]
  assessments        Assessment[]
  certificates       Certificate[]
  @@index([trainerId, status])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([courseId])
}

model LearningResource {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  type        String
  url         String
  order       Int
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([courseId])
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  status      String   @default("ENROLLED")
  progress    Int      @default(0)
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model Assessment {
  id            String              @id @default(uuid())
  courseId      String
  title         String
  description   String?
  passingScore  Float               @default(60.0)
  isPublished   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      AssessmentAttempt[]
  @@index([courseId])
}

model Question {
  id           String           @id @default(uuid())
  assessmentId String
  text         String
  points       Int              @default(1)
  order        Int
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      QuestionOption[]
  @@index([assessmentId])
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  text        String
  isCorrect   Boolean  @default(false)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id           String             @id @default(uuid())
  assessmentId String
  userId       String
  score        Float
  passed       Boolean
  submittedAt  DateTime           @default(now())
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      AssessmentAnswer[]
  certificate  Certificate?
  @@index([userId, assessmentId])
}

model AssessmentAnswer {
  id         String            @id @default(uuid())
  attemptId  String
  questionId String
  optionId   String
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String            @id @default(uuid())
  certificateCode String            @unique
  userId          String
  courseId        String
  attemptId       String            @unique
  issuedAt        DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id])
  course          Course            @relation(fields: [courseId], references: [id])
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model Announcement {
  id             String    @id @default(uuid())
  title          String
  message        String
  priority       String    @default("NORMAL")
  targetAudience String?
  publishAt      DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId])
}

model EmailLog {
  id                String    @id @default(uuid())
  recipientUserId   String?
  recipientEmail    String
  recipientRole     String?
  templateKey       String
  category          String    @default("General")
  subject           String
  status            String    @default("PENDING") // PENDING | QUEUED | SENT | FAILED | RETRYING
  triggerType       String    @default("AUTOMATIC") // AUTOMATIC | ADMIN_MANUAL
  variables         String?   // JSON stringified resolved template variables
  provider          String    @default("EmailJS")
  providerMessageId String?
  errorMessage      String?
  retryCount        Int       @default(0)
  eventId           String?   // Idempotency key
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  user              User?     @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  @@index([recipientUserId])
  @@index([templateKey])
  @@index([status])
  @@index([eventId])
}

model EmailTemplateConfig {
  id                String   @id @default(uuid())
  templateKey       String   @unique
  name              String
  category          String
  description       String
  subject           String
  emailjsTemplateId String   @default("template_v4oblec")
  enabled           Boolean  @default(true)
  automaticEnabled  Boolean  @default(true)
  adminEnabled      Boolean  @default(true)
  requiredVariables String   @default("[]") // JSON string of required keys
  defaultVariables  String   @default("{}") // JSON string of defaults
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

